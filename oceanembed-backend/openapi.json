          {
            "name": "lon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "description": "Center longitude \u00b0E",
              "examples": [
                65.0
              ],
              "title": "Lon"
            },
            "description": "Center longitude \u00b0E"
          },
          {
            "name": "radius_km",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 1000.0,
              "minimum": 1.0,
              "description": "Radius in km",
              "examples": [
                100.0
              ],
              "default": 100.0,
              "title": "Radius Km"
            },
            "description": "Radius in km"
          },
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Target date (YYYY-MM-DD)",
              "examples": [
                "2025-05-15"
              ],
              "title": "Date"
            },
            "description": "Target date (YYYY-MM-DD)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArgoProfilesResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },

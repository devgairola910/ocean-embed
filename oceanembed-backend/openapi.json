    "/api/v1/predict": {
      "get": {
        "tags": [
          "Prediction"
        ],
        "summary": "Predict vertical temperature profile",
        "operationId": "predict_api_v1_predict_get",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "description": "Latitude in \u00b0N (0 to 25)",
              "examples": [
                12.5
              ],
              "title": "Lat"
            },
            "description": "Latitude in \u00b0N (0 to 25)"
          },
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "description": "Longitude in \u00b0E (45 to 100)",
              "examples": [
                65.0
              ],
              "title": "Lon"
            },
            "description": "Longitude in \u00b0E (45 to 100)"
          },
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Target date (YYYY-MM-DD)",
              "examples": [
                "2025-05-15"
              ],
              "title": "Date"
            },
            "description": "Target date (YYYY-MM-DD)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/grid": {
      "get": {
        "tags": [
          "Grid"
        ],
        "summary": "Get 2D temperature grid slice",
        "operationId": "get_grid_api_v1_grid_get",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Target date (YYYY-MM-DD)",

  "components": {
    "schemas": {
      "ArgoFloatProfile": {
        "properties": {
          "float_id": {
            "type": "string",
            "title": "Float Id",
            "examples": [
              "ARGO_2901482"
            ]
          },
          "lat": {
            "type": "number",
            "title": "Lat",
            "examples": [
              12.6
            ]
          },
          "lon": {
            "type": "number",
            "title": "Lon",
            "examples": [
              80.1
            ]
          },
          "date": {
            "type": "string",
            "title": "Date",
            "examples": [
              "2025-05-14"
            ]
          },
          "distance_km": {
            "type": "number",
            "title": "Distance Km",
            "examples": [
              15.2
            ]
          },
          "profile": {
            "items": {
              "$ref": "#/components/schemas/ProfilePoint"
            },
            "type": "array",
            "title": "Profile"
          }
        },
        "type": "object",
        "required": [
          "float_id",
          "lat",
          "lon",
          "date",
          "distance_km",
          "profile"
        ],
        "title": "ArgoFloatProfile"
      },
      "ArgoProfilesResponse": {
        "properties": {
          "requested_location": {
            "$ref": "#/components/schemas/LocationPoint"
          },
          "radius_km": {
            "type": "number",
            "title": "Radius Km",
            "examples": [
              100.0
            ]
          },
          "date": {
            "type": "string",
            "title": "Date",
            "examples": [
              "2025-05-15"
            ]
          },
          "profiles": {
            "items": {
              "$ref": "#/components/schemas/ArgoFloatProfile"
            },
            "type": "array",
            "title": "Profiles"
          },
          "mode": {
            "type": "string",
            "title": "Mode",
            "default": "mock",
            "examples": [
              "mock"
            ]
          }
        },
        "type": "object",
        "required": [
          "requested_location",
          "radius_km",
          "date",
          "profiles"
        ],
        "title": "ArgoProfilesResponse"
      },
      "ArgoValidationResponse": {
        "properties": {
          "date_from": {
            "type": "string",
            "title": "Date From",
            "examples": [
              "2024-01-01"
            ]
          },
          "date_to": {
            "type": "string",
            "title": "Date To",
            "examples": [
              "2026-06-30"
            ]
          },
          "n_matchups": {
            "type": "integer",
            "title": "N Matchups",
            "examples": [
              1450
            ]
          },
          "overall": {
            "$ref": "#/components/schemas/OverallValidation"
          },
          "by_depth": {
            "items": {
              "$ref": "#/components/schemas/DepthValidation"
            },
            "type": "array",
            "title": "By Depth"
          },
          "mode": {
            "type": "string",
            "title": "Mode",
            "default": "mock",
            "examples": [
              "mock"
            ]
          }
        },
        "type": "object",
        "required": [
          "date_from",
          "date_to",
          "n_matchups",
          "overall",
          "by_depth"
        ],
        "title": "ArgoValidationResponse"
      },
      "CycloneRiskResponse": {
        "properties": {
          "location": {
            "$ref": "#/components/schemas/LocationPoint"
          },
          "date": {
            "type": "string",
            "title": "Date",
            "examples": [
              "2025-05-15"
            ]
          },
          "tchp_score_kj_cm2": {
            "type": "number",
            "title": "Tchp Score Kj Cm2",
            "description": "Tropical Cyclone Heat Potential in kJ/cm^2",
            "examples": [
              62.4
            ]
          },
          "isotherm_26c_depth_m": {
            "type": "number",
            "title": "Isotherm 26C Depth M",
            "description": "Depth of 26\u00b0C isotherm in meters",
            "examples": [
              65.0
            ]
          },
          "risk_category": {
            "type": "string",
            "title": "Risk Category",
            "description": "Low, Moderate, or High",
            "examples": [
              "Moderate"
            ]
          },
          "mode": {
            "type": "string",
            "title": "Mode",
            "default": "mock",
            "examples": [
              "mock"
            ]
          }
        },
        "type": "object",
        "required": [
          "location",
          "date",
          "tchp_score_kj_cm2",
          "isotherm_26c_depth_m",
          "risk_category"
        ],
        "title": "CycloneRiskResponse"
      },
      "DepthRange": {
        "properties": {
          "min": {
            "type": "number",
            "title": "Min",
            "default": 0.0,
            "examples": [
              0.0
            ]
          },
          "max": {
            "type": "number",
            "title": "Max",
            "default": 450.0,
            "examples": [
              450.0
            ]
          }
        },
        "type": "object",
        "title": "DepthRange"

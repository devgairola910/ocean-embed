              }
            }
          }
        }
      }
    },
    "/api/v1/transect": {
      "get": {
        "tags": [
          "Transect"
        ],
        "summary": "Sample ocean transect profile along a line",
        "operationId": "get_transect_api_v1_transect_get",
        "parameters": [
          {
            "name": "lat1",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "description": "Start latitude \u00b0N",
              "examples": [
                10.0
              ],
              "title": "Lat1"
            },
            "description": "Start latitude \u00b0N"
          },
          {
            "name": "lon1",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "description": "Start longitude \u00b0E",
              "examples": [
                65.0
              ],
              "title": "Lon1"
            },
            "description": "Start longitude \u00b0E"
          },
          {
            "name": "lat2",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "description": "End latitude \u00b0N",
              "examples": [
                15.0
              ],
              "title": "Lat2"
            },
            "description": "End latitude \u00b0N"
          },
          {
            "name": "lon2",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "description": "End longitude \u00b0E",
              "examples": [
                75.0
              ],
              "title": "Lon2"
            },
            "description": "End longitude \u00b0E"
          },
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Target date (YYYY-MM-DD)",
              "examples": [
                "2025-05-15"
              ],
              "title": "Date"
            },
            "description": "Target date (YYYY-MM-DD)"
          },
          {
            "name": "n_points",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 2,
              "description": "Number of sampling points",
              "examples": [
                50
              ],
              "default": 50,
              "title": "N Points"
            },
            "description": "Number of sampling points"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransectResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/argo/validation": {
      "get": {
